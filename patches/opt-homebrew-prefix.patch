+can_write_prefix() {
+  if [[ -e "${HOMEBREW_PREFIX}" ]]
+  then
+    [[ -w "${HOMEBREW_PREFIX}" ]]
+  else
+    local parent
+    parent="$(dirname "${HOMEBREW_PREFIX}")"
+    while [[ ! -d "${parent}" && "${parent}" != "/" && "${parent}" != "." ]]
+    do
+      parent="$(dirname "${parent}")"
+    done
+    [[ -w "${parent}" ]]
+  fi
+}
+
